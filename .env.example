# Fournisseur : ollama, openai ou compatible
LLM_PROVIDER=ollama

# Ollama (défaut, local et gratuit)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=qwen2.5:3b

# Mettre true seulement si le modèle sait lire des images (par exemple llava, qwen2.5vl).
LLM_SUPPORTS_VISION=false

# API compatible OpenAI. Ne pas committer de clé réelle.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4.1-mini

# PDF_PATH=pdfs/attention is all you need.pdf
